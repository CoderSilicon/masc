{
	"name": "masc",
	"private": true,
	"version": "1.0.0",
	"description": "Client-side steganography for hiding messages and files inside images.",
	"license": "SEE LICENSE IN LICENSE",
	"author": "CoderSilicon (https://github.com/CoderSilicon)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CoderSilicon/masc.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build:wasm": "wasm-pack build crates/steg-core --target web --out-dir ../../static/wasm --release",
		"test:steg": "node --test tests/steg/*.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^22.20.5",
		"@types/three": "^0.182.0",
		"sass-embedded": "^1.97.3",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"gsap": "^3.14.2",
		"lucide-svelte": "^0.563.0",
		"tailwindcss": "^4.1.18",
		"wasm-pack": "^0.15.0"
	}
}
